---
// src/pages/servicios.astro
import Layout from "../layouts/Layout.astro";

const servicios = [
    {
        anchor: "srv-erp",
        icon: "fa-solid fa-database",
        tag: "Sistemas",
        title: "Sistemas ERP a la medida",
        subtitle: "Todo tu negocio, en un solo sistema",
        text: "Plataformas administrativas, financieras y contables hechas a la medida de tu empresa, sin importar su giro o tamaño.",
        items: [
            "Control de clientes, proveedores y compras en un solo lugar",
            "Reportes financieros claros, sin armarlos a mano en Excel",
            "Cruce automático entre tus movimientos bancarios y tus facturas del SAT",
        ],
        meta: [
            { label: "Tiempo estimado", value: "Según la complejidad y alcance" },
            { label: "Ideal para", value: "Operaciones con varias áreas" },
        ],
    },
    {
        anchor: "srv-web",
        icon: "fa-solid fa-globe",
        tag: "Presencia",
        title: "Diseño de páginas web",
        subtitle: "Sitios y páginas para que te encuentren en internet",
        text: "La cara de tu negocio en internet: sitios modernos, responsivos y pensados para que te encuentren.",
        items: [
            "Página para presentar o vender tus productos y servicios",
            "Páginas informativas y blogs",
            "Propuestas y asesoría de contenido",
        ],
        meta: [
            { label: "Tiempo estimado", value: "1–3 semanas" },
            { label: "Ideal para", value: "Negocios que necesitan presencia rápida" },
        ],
    },
    {
        anchor: "srv-dominios",
        icon: "fa-solid fa-at",
        tag: "Identidad",
        title: "Dominios y correos para empresas",
        subtitle: "Dominio.com / correo@Dominio.com",
        text: "Tu espacio propio en internet, administrado por nosotros, con correos a tu nombre de dominio.",
        items: [
            "Registro y administración de dominio",
            "Correos profesionales personalizados",
            "Publicación de tu sitio en línea",
        ],
        meta: [
            { label: "Tiempo estimado", value: "2–5 días" },
            { label: "Ideal para", value: "Empresas sin presencia formal aún" },
        ],
    },
    {
        anchor: "srv-soporte",
        icon: "fa-solid fa-headset",
        tag: "Acompañamiento",
        title: "Soporte técnico especializado",
        subtitle: "Capacitación y asistencia",
        text: "Te acompañamos y capacitamos a tu equipo para que le saquen el máximo provecho a tu sistema, sin quedarte solo después de la entrega.",
        items: [
            "Asistencia personalizada",
            "Capacitación por área",
            "Resolución de dudas en el camino",
        ],
        meta: [
            { label: "Disponibilidad", value: "Bajo demanda" },
            { label: "Modalidad", value: "Remota o en sitio" },
            { label: "Ideal para", value: "Equipos que ya usan un sistema" },
        ],
    },
];
---

<Layout title="Servicios">
    <section class="hero-cosmic-sm">
        <div class="hero-constellation" aria-hidden="true">
            <svg viewBox="0 0 1000 400" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <pattern id="bpGrid" width="42" height="42" patternUnits="userSpaceOnUse">
                        <path d="M 42 0 L 0 0 0 42" fill="none" stroke="rgba(133,203,213,0.10)" stroke-width="1" />
                    </pattern>
                    <pattern id="bpGridBold" width="168" height="168" patternUnits="userSpaceOnUse">
                        <path d="M 168 0 L 0 0 0 168" fill="none" stroke="rgba(133,203,213,0.16)" stroke-width="1" />
                    </pattern>
                </defs>
                <rect width="1000" height="400" fill="url(#bpGrid)" />
                <rect width="1000" height="400" fill="url(#bpGridBold)" />

                <path class="bp-corner" d="M20,54 L20,20 L54,20" />
                <path class="bp-corner" d="M946,380 L980,380 L980,346" />

                <g class="bp-mark">
                    <circle cx="630" cy="90" r="13" />
                    <line x1="608" y1="90" x2="652" y2="90" />
                    <line x1="630" y1="68" x2="630" y2="112" />
                    <text class="hero-node-label" x="650" y="86">01 · ERP</text>
                </g>
                <g class="bp-mark">
                    <circle cx="780" cy="150" r="13" />
                    <line x1="758" y1="150" x2="802" y2="150" />
                    <line x1="780" y1="128" x2="780" y2="172" />
                    <text class="hero-node-label" x="800" y="146">02 · Web</text>
                </g>
                <g class="bp-mark">
                    <circle cx="690" cy="240" r="13" />
                    <line x1="668" y1="240" x2="712" y2="240" />
                    <line x1="690" y1="218" x2="690" y2="262" />
                    <text class="hero-node-label" x="600" y="264">03 · Dominios</text>
                </g>
                <g class="bp-mark">
                    <circle cx="900" cy="270" r="13" />
                    <line x1="878" y1="270" x2="922" y2="270" />
                    <line x1="900" y1="248" x2="900" y2="292" />
                    <text class="hero-node-label" x="838" y="296">04 · Soporte</text>
                </g>
            </svg>
        </div>

        <div class="relative z-10 max-w-2xl">
            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <a href="/">Inicio</a>
                <span class="sep">/</span>
                <span class="current">Servicios</span>
            </nav>
            <span class="hero-tagline"><span class="n">4</span> servicios · con alcance y tiempos claros</span>
            <h1 class="text-3xl sm:text-4xl font-semibold">
                Un servicio para cada necesidad de tu negocio
            </h1>
            <p class="mt-4 text-brand-300">
                En Codexart no vendemos paquetes cerrados: cada servicio se ajusta al tamaño y a las prioridades reales de tu negocio.
            </p>
            <div class="hero-trust">
                <span class="dot"></span>
                Cotización clara antes de empezar · Capacitación incluida en cada proyecto
            </div>
        </div>
    </section>

    <!-- Intro del detalle -->
    <section class="px-8 sm:px-16 pt-16 pb-4">
        <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-3xl">Del sistema completo al detalle que falta</h2>
            <p class="mt-3 text-gray-500">
                Para cada servicio, encontrarás qué incluye, cuánto tarda y para qué tipo de negocio es ideal — sin letras chiquitas.
            </p>
        </div>
    </section>

    <!-- Un servicio por sección, con su propio espacio -->
    {
        servicios.map((servicio, i) => (
            <section id={servicio.anchor} class={"scroll-mt-24 px-8 sm:px-16 py-14" + (i % 2 === 0 ? " bg-white" : "")}>
                <div class="max-w-5xl mx-auto grid gap-10 md:grid-cols-[1fr_260px] md:items-start">
                    <div>
                        <div class="flex items-center gap-4 mb-3">
                            <div class="service-icon">
                                <i class={servicio.icon}></i>
                            </div>
                            <span class="service-num">{servicio.tag}</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-semibold">{servicio.title}</h2>
                        <h4 class="text-gray-400 font-medium text-sm mt-1">{servicio.subtitle}</h4>
                        <p class="mt-4 text-gray-600 max-w-xl">{servicio.text}</p>
                        <ul class="sol-panel-list">
                            {servicio.items.map((item) => (
                                <li>
                                    <span class="check">
                                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                                    </span>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div class="sol-panel-meta rounded-2xl">
                        <span class="meta-title">Ficha técnica</span>
                        {servicio.meta.map((row) => (
                            <div class="meta-row">
                                <strong>{row.label}</strong>
                                <span>{row.value}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        ))
    }

    <!-- CTA -->
    <section class="px-8 sm:px-16 py-16">
        <div class="max-w-4xl mx-auto cta-final">
            <h2 class="text-3xl font-bold mb-4">¿No estás seguro de qué necesitas?</h2>
            <p class="text-lg mb-8 max-w-lg mx-auto">
                Con gusto te ayudamos a decidir, sin compromiso.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/contactanos" class="inline-flex items-center justify-center gap-2 bg-amber-400 text-ink-950 px-8 py-3 rounded-full font-bold transition-colors hover:bg-amber-300">
                    <i class="fa-solid fa-up-right-from-square"></i>
                    Solicita tu cotización
                </a>
                <a
                    href="https://wa.me/529937212616"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-emerald-600 text-white px-8 py-3 rounded-full font-bold transition-colors hover:bg-emerald-700"
                >
                    <i class="fa-brands fa-whatsapp"></i>
                    Escríbenos por WhatsApp
                </a>
            </div>
        </div>
    </section>
</Layout>