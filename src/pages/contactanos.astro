---
// src/pages/contactanos.astro
import Layout from "../layouts/Layout.astro";

const redes = [
    { name: "Facebook", href: "https://facebook.com/codexart.dev", icon: "fa-brands fa-facebook-f" },
    { name: "Instagram", href: "https://instagram.com/codexart.dev", icon: "fa-brands fa-instagram" },
    { name: "LinkedIn", href: "https://linkedin.com/company/codexart.dev", icon: "fa-brands fa-linkedin-in" },
    { name: "YouTube", href: "https://youtube.com/codexart", icon: "fa-brands fa-youtube" },
];
---

<Layout title="Contáctanos">
    <!-- Hero -->
    <section class="hero-cosmic-sm">
        <div class="hero-constellation" aria-hidden="true">
            <svg viewBox="0 0 1000 380" preserveAspectRatio="xMidYMid slice">
                <circle class="hero-star dim" cx="70" cy="60" r="1.2" />
                <circle class="hero-star dim" cx="130" cy="300" r="1.2" />
                <circle class="hero-star mid" cx="960" cy="60" r="1.3" />
                <circle class="hero-star dim" cx="900" cy="310" r="1.2" />

                <g>
                    <circle class="ping-ring r3" cx="760" cy="180" r="150" />
                    <circle class="ping-ring r2" cx="760" cy="180" r="100" />
                    <circle class="ping-ring r1" cx="760" cy="180" r="55" />
                    <circle class="ping-center" cx="760" cy="180" r="6" />
                    <text class="hero-node-label" x="778" y="176">Tu mensaje</text>
                    <text class="hero-node-label" x="778" y="192" opacity="0.7">llega directo</text>
                </g>
            </svg>
        </div>

        <div class="relative z-10 max-w-2xl">
            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <a href="/">Inicio</a>
                <span class="sep">/</span>
                <span class="current">Contáctanos</span>
            </nav>
            <h1 class="text-3xl sm:text-4xl font-semibold">
                Estamos listos para ayudarte con tu proyecto
            </h1>
            <p class="mt-4 text-brand-300 max-w-lg">
                Cuéntanos qué necesitas y te respondemos directo — sin formularios que se pierden en un buzón genérico.
            </p>
            <div class="hero-trust">
                <span class="dot"></span>
                Respuesta en menos de 24 horas hábiles
            </div>
        </div>
    </section>

    <section class="px-8 sm:px-16 py-16">
        <div class="max-w-6xl mx-auto grid gap-8 md:grid-cols-[1.4fr_1fr] items-start">

            <!-- Formulario -->
            <div class="form-card">
                <h2 class="text-2xl">Escríbenos y te respondemos personalmente</h2>
                <p>Entre más contexto nos des, más precisos podemos ser en la primera respuesta.</p>

                <!-- Formulario listo para Netlify Forms: name="contacto" + data-netlify="true" para que
                     Netlify lo detecte al desplegar, el input oculto form-name, el honeypot bot-field
                     para filtrar bots, y action="/gracias" a donde redirige tras un envío exitoso. -->
                <form
                    name="contacto"
                    method="POST"
                    data-netlify="true"
                    netlify-honeypot="bot-field"
                    action="/gracias"
                    class="contact-form"
                >
                    <input type="hidden" name="form-name" value="contacto" />
                    <p class="honeypot-field" aria-hidden="true">
                        <label>No llenar este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
                    </p>

                    <div class="form-row-pair">
                        <div class="field">
                            <label for="nombre">Nombre</label>
                            <input id="nombre" name="nombre" type="text" autocomplete="name" required />
                        </div>
                        <div class="field">
                            <label for="correo">Correo electrónico</label>
                            <input id="correo" name="correo" type="email" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="field">
                        <label for="asunto">Asunto</label>
                        <input id="asunto" name="asunto" type="text" placeholder="Ej. Sistema para conciliación bancaria" required />
                    </div>

                    <div class="field">
                        <label for="mensaje">Mensaje</label>
                        <textarea id="mensaje" name="mensaje" placeholder="Cuéntanos cómo trabaja tu empresa hoy y qué te gustaría resolver." required></textarea>
                    </div>

                    <div class="form-foot">
                        <button type="submit" class="inline-flex items-center gap-2 bg-amber-400 text-ink-950 px-6 py-3 rounded-full font-bold transition-colors hover:bg-amber-300">
                            Enviar mensaje
                        </button>
                        <span class="form-note">Al enviar, tu mensaje llega directo al correo de Codexart — no se comparte con nadie más.</span>
                    </div>
                </form>
            </div>

            <!-- Contacto directo y redes -->
            <div>
                <div class="info-card">
                    <p class="text-brand-300 text-sm mb-1">¿Prefieres algo más directo?</p>
                    <h3>Escríbenos por WhatsApp</h3>
                    <div class="info-list">
                        <div class="info-item">
                            <span class="ic"><i class="fa-solid fa-envelope"></i></span>
                            <div>
                                <strong>Correo</strong>
                                <a href="mailto:contacto@codexart.com">contacto@codexart.com</a>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="ic"><i class="fa-brands fa-whatsapp"></i></span>
                            <div>
                                <strong>WhatsApp</strong>
                                <a href="https://wa.me/529937212616" target="_blank" rel="noopener noreferrer">+52 993 721 2616</a>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="ic"><i class="fa-solid fa-location-dot"></i></span>
                            <div>
                                <strong>Ubicación</strong>
                                <span>Tabasco, México</span>
                            </div>
                        </div>
                    </div>
                    <a
                        class="mt-6 inline-flex items-center justify-center gap-2 w-full bg-emerald-600 text-white px-6 py-3 rounded-full font-bold transition-colors hover:bg-emerald-700"
                        href="https://wa.me/529937212616?text=Hola%2C%20me%20interesa%20platicar%20sobre%20un%20proyecto"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Abrir WhatsApp
                    </a>
                </div>

                <div class="social-card">
                    <h4>Síguenos</h4>
                    <div class="social-row">
                        {
                            redes.map((red) => (
                                <a href={red.href} target="_blank" rel="noopener noreferrer" aria-label={red.name}>
                                    <i class={red.icon}></i>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>
</Layout>
