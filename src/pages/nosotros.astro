---
// src/pages/nosotros.astro
import Layout from "../layouts/Layout.astro";

// Valores de la marca.
const valores = [
    {
        icon: "fa-solid fa-bullseye",
        title: "Soluciones a la medida",
        text: "En Codexart construimos herramientas que se ajustan a tu forma de trabajar, no al revés.",
    },
    {
        icon: "fa-solid fa-code",
        title: "Construido para durar",
        text: "Sistemas simples y bien pensados, que no se caen y que puedes seguir haciendo crecer sin rehacerlos desde cero.",
    },
    {
        icon: "fa-solid fa-gauge-high",
        title: "Calidad y disponibilidad",
        text: "Lo que antes vivía en hojas de Excel, ahora corre en línea — disponible a cualquier hora, todos los días del año.",
    },
    {
        icon: "fa-solid fa-handshake",
        title: "Cercanía y acompañamiento",
        text: "Trato directo de principio a fin: tú hablas con quien diseña y desarrolla tu proyecto.",
    },
];

// Identidad de marca.
const identidad = [
    "Tecnología",
    "Negocio",
    "Confianza",
    "Cercanía",
    "Profesionalismo",
    "Compromiso",
    "Crecimiento",
];
---

<Layout title="Nosotros">
    <!-- Hero -->
    <section class="hero-cosmic-sm">
        <div class="hero-constellation" aria-hidden="true">
            <svg viewBox="0 0 1000 400" preserveAspectRatio="xMidYMid slice">
                <circle class="hero-star dim" cx="60" cy="50" r="1.2" />
                <circle class="hero-star dim" cx="140" cy="320" r="1.2" />
                <circle class="hero-star mid" cx="960" cy="330" r="1.3" />
                <circle class="hero-star dim" cx="920" cy="40" r="1.2" />

                <g>
                    <ellipse class="orbit-ring" cx="680" cy="200" rx="90" ry="52" />
                    <ellipse class="orbit-ring" cx="680" cy="200" rx="150" ry="92" />
                    <ellipse class="orbit-ring" cx="680" cy="200" rx="215" ry="134" />

                    <circle class="orbit-center" cx="680" cy="200" r="6" />
                    <text class="hero-node-label" x="694" y="196">Codexart</text>

                    <circle class="hero-node" cx="590" cy="200" r="3.5" />
                    <text class="hero-node-label" x="520" y="196">Tabasco</text>

                    <circle class="hero-node" cx="830" cy="150" r="3.5" />
                    <text class="hero-node-label" x="840" y="146">.NET · Angular</text>

                    <circle class="hero-node" cx="680" cy="66" r="3.5" />
                    <text class="hero-node-label" x="600" y="52">SAT · CFDI</text>

                    <circle class="hero-node" cx="530" cy="270" r="3.5" />
                    <text class="hero-node-label" x="440" y="294">Full Stack</text>
                </g>
            </svg>
        </div>

        <div class="relative z-10 max-w-2xl">
            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <a href="/">Inicio</a>
                <span class="sep">/</span>
                <span class="current">Nosotros</span>
            </nav>
            <h1 class="text-3xl sm:text-4xl font-semibold">
                Acerca de <span class="text-amber-400">Codexart</span>
            </h1>
            <p class="mt-4 text-brand-300 max-w-lg">
                Detrás de cada proyecto hay una sola persona: la que te escucha, diseña tu sistema y te acompaña hasta que funciona.
            </p>
            <div class="hero-trust">
                <span class="dot"></span>
                Un solo interlocutor, de la propuesta a la capacitación final
            </div>
        </div>
    </section>

    <!-- Detrás de Codexart -->
    <section class="bg-white px-8 sm:px-16 py-16">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[260px_1fr] gap-10 items-start">
            <div>
                <img
                    src="/ruben.jpg"
                    alt="Fundador de Codexart en su oficina"
                    class="w-full aspect-square object-cover rounded-2xl shadow shadow-brand-200 border border-slate-200"
                />
                <p class="bio-role">Fundador de Codexart<br />Diseña y construye cada proyecto, de principio a fin</p>
            </div>
            <div>
                <h2 class="text-3xl">La persona detrás de Codexart</h2>

                <p class="mt-4 text-gray-600 leading-relaxed">
                    Codexart nació en Tabasco de una necesidad muy concreta: negocios que seguían llevando su
                    operación en hojas de cálculo, sin ver con claridad lo que pasaba día a día en su empresa. De
                    ahí nació Codexart, la marca de software de Rubén Vázquez, para resolver justo eso.
                </p>
                <p class="mt-4 text-gray-600 leading-relaxed">
                    En Codexart nos especializamos en construir software empresarial serio: sistemas pensados
                    para que sigan funcionando bien incluso cuando tu negocio cambie o crezca, sin tener que
                    empezar de cero cada vez.
                </p>
                <p class="mt-4 text-gray-600 leading-relaxed">
                    Codexart tiene experiencia particular en sistemas financieros, contables y fiscales, con
                    conexión directa a tus facturas y trámites del SAT — la parte del negocio donde un error sale
                    caro de verdad.
                </p>

                <p class="bio-slogan">"Si puedes imaginarlo... puedes programarlo."</p>

                <a href="/contactanos" class="cdx-button inline-flex items-center mt-8">
                    <i class="fa-solid fa-up-right-from-square mr-2"></i>
                    Trabajemos juntos
                </a>
            </div>
        </div>
    </section>

    <!-- Cómo trabajamos -->
    <section class="px-8 sm:px-16 py-16">
        <div class="max-w-2xl mx-auto text-center mb-12">
            <h2 class="text-3xl">Cómo trabajamos</h2>
            <p class="mt-3 text-gray-500">Cuatro cosas que no negociamos en un proyecto.</p>
        </div>
        <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                valores.map((valor) => (
                    <div class="bg-white rounded-lg border border-slate-200 shadow shadow-brand-200 p-6 text-center">
                        <i class={valor.icon + " text-3xl text-brand-600 mb-4"}></i>
                        <h3 class="font-semibold mb-2">{valor.title}</h3>
                        <p class="text-gray-600 text-sm">{valor.text}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Misión y visión -->
    <section class="mission-section">
        <div class="mission-grid">
            <div class="mission-block">
                <h3>Misión</h3>
                <!-- TODO: confirmar si Codexart ofrece actualmente apps móviles y plataformas SaaS.
                     Si es así, se pueden reincorporar aquí como parte de la misión. -->
                <p>
                    En Codexart convertimos procesos que hoy se hacen a mano —en Excel, en papel, en la
                    memoria de alguien— en sistemas hechos a la medida de cada negocio, para que tomar
                    decisiones sea más simple y haya menos margen de error.
                </p>
            </div>
            <div class="mission-block">
                <h3>Visión</h3>
                <p>
                    Queremos ser la primera opción cuando un negocio mexicano piensa "necesito un sistema
                    hecho para mí, no una plantilla genérica" — y que cada cliente sienta que trabajó con
                    alguien que de verdad entendió su negocio, no con un proveedor más.
                </p>
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-12">
            <h3 class="text-lg font-semibold">Lo que nos define</h3>
            <div class="flex flex-wrap gap-3 mt-3">
                {
                    identidad.map((valor) => (
                        <span class="identity-pill">{valor}</span>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Llamado a la acción final -->
    <section class="px-8 sm:px-16 py-16">
        <div class="max-w-4xl mx-auto cta-final">
            <h2 class="text-3xl font-bold mb-4">¿Conversamos sobre tu proyecto?</h2>
            <p class="text-lg mb-8 max-w-lg mx-auto">
                Sin intermediarios ni letra chiquita: hablas directo con Codexart desde la primera llamada.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="mailto:contacto@codexart.com" class="inline-flex items-center justify-center gap-2 bg-amber-400 text-ink-950 px-8 py-3 rounded-full font-bold transition-colors hover:bg-amber-300">
                    <i class="fa-solid fa-paper-plane"></i>
                    Contáctanos
                </a>
                <a
                    href="https://wa.me/529937212616"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-emerald-600 text-white px-8 py-3 rounded-full font-bold transition-colors hover:bg-emerald-700"
                >
                    <i class="fa-brands fa-whatsapp"></i>
                    Escríbenos por WhatsApp
                </a>
            </div>
        </div>
    </section>
</Layout>
